// RP2350 (RP235x) I2S audio output driver API (PCM5102A DAC).
//
// Drives a PCM5102A stereo DAC in 3-wire I2S mode via PIO0 + DMA: BCK (GP26),
// LRCK (GP27), DIN (GP22). The DAC's SCK pin must be grounded so its internal
// PLL synthesises the system clock from BCK (see docs/pcm5102a-research). I2S
// format, 16-bit samples in 32-bit slots (BCK = 64*fs); PLL-supported rates are
// 16/32/44.1/48 kHz.
//
// Stage 1 exposes only a self-generated sine test tone, to validate the DAC and
// the PIO/DMA plumbing before the SD-card decode path is wired in.

Interface(
    name: "Rp235xI2s",
    ops: {
        "tone": (
            description: "Play a sine at `freq_hz` (50..=8000) out both channels at `rate_hz` (16000/32000/44100/48000) for `ms`, then silence. BLOCKING for the duration.",
            args: { "freq_hz": "u32", "rate_hz": "u32", "ms": "u32" },
            reply: Result(ok: "()", err: CLike("I2sError")),
            idempotent: true,
        ),
        "audio_start": (
            description: "Start a seamless-looping sine near `freq_hz` (50..=8000) in both channels at `rate_hz`, fed by a DMA ring paced by the PIO TX DREQ. Non-blocking: returns immediately, the DMA loops with zero CPU. Pitch snaps to whole cycles across the buffer.",
            args: { "freq_hz": "u32", "rate_hz": "u32" },
            reply: Result(ok: "()", err: CLike("I2sError")),
            idempotent: true,
        ),
        "audio_stereo": (
            description: "Like audio_start but distinct pitches: `hz_left` / `hz_right` (each 50..=8000) at `rate_hz`. Non-blocking; each channel snaps to whole cycles across the buffer.",
            args: { "hz_left": "u32", "hz_right": "u32", "rate_hz": "u32" },
            reply: Result(ok: "()", err: CLike("I2sError")),
            idempotent: true,
        ),
        "audio_stop": (
            description: "Stop the DMA-fed sine: abort the DMA channel and feed silence (zeros) so the DAC's zero-data detect analog-mutes.",
            args: {},
            reply: Result(ok: "()", err: CLike("I2sError")),
            idempotent: true,
        ),
        "dbg": (
            description: "Bring-up register peek (this task holds the pio0/dma MPU grants the shell lacks). which: 0=DMA ch CTRL, 1=remaining TRANS_COUNT, 2=READ_ADDR, 3=WRITE_ADDR, 4=PIO FSTAT, 5=PIO FDEBUG, 6=PIO FLEVEL, 7=PIO CTRL, 8=SM0 EXECCTRL, else 0.",
            args: { "which": "u8" },
            reply: Result(ok: "u32", err: CLike("I2sError")),
            idempotent: true,
        ),
    },
)
