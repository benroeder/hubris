// Sony S-Link / Control-A1 driver API (branch slink).
//
// A single bidirectional open-collector control line (idle HIGH, active-LOW
// pulses whose width encodes the symbol: SYNC 2400us, one 1200us, zero 600us,
// each followed by a ~600us HIGH delimiter). Bytes are MSB-first; a frame is
// 2-3 bytes (device id + command(s)). Bit-banged on GP4, reusing the existing
// board-to-board straight wire (I2C SDA position) + ground.

Interface(
    name: "Rp235xSlink",
    ops: {
        "send": (
            description: "Transmit an S-Link frame of `n` (2 or 3) bytes b0,b1,b2, MSB-first.",
            args: { "b0": "u8", "b1": "u8", "b2": "u8", "n": "u8" },
            reply: Simple("()"),
            idempotent: true,
        ),
        "listen": (
            description: "Wait up to `timeout_ms` for one frame. Returns packed (count<<24)|(b0<<16)|(b1<<8)|b2, or 0 on timeout.",
            args: { "timeout_ms": "u32" },
            reply: Simple("u32"),
            idempotent: true,
        ),
        "flood": (
            description: "Stress sender: transmit `n` self-checking 3-byte frames [seq, seq^0xa5, seq+0x33] back-to-back (seq wraps 0..255, so n>=256 covers every byte value).",
            args: { "n": "u32" },
            reply: Simple("()"),
            idempotent: true,
        ),
        "soak": (
            description: "Stress listener: receive up to `n` frames within `timeout_ms`, validating each self-checking frame. Returns (bad<<16)|good. Also records per-symbol mark-width min/max (see margin_ones/zeros).",
            args: { "n": "u32", "timeout_ms": "u32" },
            reply: Simple("u32"),
            idempotent: true,
        ),
        "margin_ones": (
            description: "Measured LOW-mark width (us) for logical ones during the last soak: (min<<16)|max.",
            args: {},
            reply: Simple("u32"),
            idempotent: true,
        ),
        "margin_zeros": (
            description: "Measured LOW-mark width (us) for logical zeros during the last soak: (min<<16)|max.",
            args: {},
            reply: Simple("u32"),
            idempotent: true,
        ),
    },
)
