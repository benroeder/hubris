// RP2350 (RP235x) GPIO driver API.
//
// Minimal Bank 0 GPIO control (pins 0-31) via SIO. Pins are configured as SIO
// outputs/inputs and driven/read through the single-cycle IO block.

Interface(
    name: "Rp235xGpio",
    ops: {
        "configure_output": (
            description: "Set a pin to SIO output (clears the RP2350 pad isolation latch).",
            args: { "pin": "u8" },
            reply: Result(ok: "()", err: CLike("GpioError")),
            idempotent: true,
        ),
        "configure_input": (
            description: "Set a pin to SIO input with the input buffer enabled.",
            args: { "pin": "u8" },
            reply: Result(ok: "()", err: CLike("GpioError")),
            idempotent: true,
        ),
        "configure_analog": (
            description: "Put a pin in analog mode for the ADC: pad output-disable (OD=1) AND input-disable (IE=0) so the digital pad neither drives nor loads the pin, and NULL funcsel. Needed for a clean read of ADC channels 0-3 (GPIO26-29).",
            args: { "pin": "u8" },
            reply: Result(ok: "()", err: CLike("GpioError")),
            idempotent: true,
        ),
        "set_high": (
            args: { "pin": "u8" },
            reply: Result(ok: "()", err: CLike("GpioError")),
            idempotent: true,
        ),
        "set_low": (
            args: { "pin": "u8" },
            reply: Result(ok: "()", err: CLike("GpioError")),
            idempotent: true,
        ),
        "toggle": (
            args: { "pin": "u8" },
            reply: Result(ok: "()", err: CLike("GpioError")),
            idempotent: true,
        ),
        "set_pull": (
            description: "Set a pin's pad pulls: 0 = none, 1 = pull-up, 2 = pull-down. NOTE erratum RP2350-E9: latched pad inputs can defeat the internal pull-down; prefer pull-ups for inputs (see the driver docs).",
            args: { "pin": "u8", "pull": "u8" },
            reply: Result(ok: "()", err: CLike("GpioError")),
            idempotent: true,
        ),
        "set_function": (
            description: "Route a pin to an alternate function (IO_BANK0 FUNCSEL value, e.g. 4 = PWM, 5 = SIO).",
            args: { "pin": "u8", "funcsel": "u8" },
            reply: Result(ok: "()", err: CLike("GpioError")),
            idempotent: true,
        ),
        "read": (
            description: "Read a pin's current input level (0 or 1).",
            args: { "pin": "u8" },
            reply: Result(ok: "u8", err: CLike("GpioError")),
            idempotent: true,
        ),
    },
)
