// RP2350 (RP235x) PWM driver API.
//
// Minimal duty-cycle control: 1 kHz period, percent duty on one channel of
// one of the twelve slices. The GPIO must separately be function-selected to
// PWM (funcsel 4) via the GPIO driver.

Interface(
    name: "Rp235xPwm",
    ops: {
        "set_duty": (
            description: "Drive slice/channel (chan_b: 0 = A, nonzero = B) at `percent` duty, 1 kHz. Enables the slice.",
            args: { "slice": "u8", "chan_b": "u8", "percent": "u8" },
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
        "disable": (
            description: "Stop a slice (both channels).",
            args: { "slice": "u8" },
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
        "tone": (
            description: "Play a square wave on channel A of `slice` at `freq_hz` (100..=6000) for `ms`, then stop (silence).",
            args: { "slice": "u8", "freq_hz": "u32", "ms": "u32" },
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
        "sine": (
            description: "Play a sine wave on channel A of `slice` at `freq_hz` (50..=5000) for `ms` via PWM-as-1-bit-DAC (DDS over a sine LUT), then stop (silence).",
            args: { "slice": "u8", "freq_hz": "u32", "ms": "u32" },
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
        "audio_start": (
            description: "Start a seamless-looping sine near `freq_hz` (50..=8000) in BOTH ears of the audio jack (GP18 = slice 1 chan A = left, GP19 = chan B = right), fed by a DMA ring of stereo (u32) samples paced by the slice-1 wrap. Non-blocking: returns immediately and the DMA loops with zero CPU. Pitch snaps to whole cycles across the sample buffer.",
            args: { "freq_hz": "u32" },
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
        "audio_stereo": (
            description: "Start a seamless-looping stereo sine on the audio jack: `hz_left` (50..=8000) on GP18 (slice 1 chan A) and `hz_right` (50..=8000) on GP19 (chan B), fed by one DMA ring of u32 samples paced by the slice-1 wrap. Non-blocking. Each channel snaps to whole cycles across the sample buffer.",
            args: { "hz_left": "u32", "hz_right": "u32" },
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
        "audio_stop": (
            description: "Stop the DMA-fed audio-jack sine: abort the DMA channel and disable slice 1.",
            args: {},
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
        "audio_mic_start": (
            description: "Real-time mic->jack passthrough: free-run the ADC on channel 2 (GP28) and DMA each 12-bit sample straight into the slice-1 chan-A compare (GP18 = jack left), zero CPU per sample. MONO: only chan A is fed; GP19 (right) stays parked mid-scale (silent). Non-blocking; runs until audio_mic_stop. Aborts any running audio/sine DMA on ch0 first.",
            args: {},
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
        "audio_mic_stop": (
            description: "Stop the mic->jack passthrough: abort the DMA channel, stop the ADC free-run, and disable slice 1.",
            args: {},
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
        "play_file": (
            description: "Stream a 16-bit PCM WAV from the FAT root of the SD card out the audio jack (GP18/GP19). Opens `name` (an 8.3 short name), reads the WAV header, programs slice 1 for the file's sample rate, and drives the same DMA ring as `audio` while poll-refilling it from the file until EOF. BLOCKING: this holds the pwm server for the whole track duration. Returns the detected sample rate on success. Shares slice 1 + DMA ch0 with the other audio paths (aborts ch0 first).",
            args: {},
            leases: {
                "name": (type: "[u8]", read: true, max_len: Some(12)),
            },
            reply: Result(ok: "u32", err: CLike("PwmError")),
        ),
        "play_mix": (
            description: "Like `play_file`, but mixes the WAV against a fixed 660 Hz DDS sine into the same DMA ring, with a button-driven auto-crossfade: GP20 fades to the WAV, GP21 fades to the sine (gains ramp 1 Q8 step per sample, click-free). The pwm task reads GP20/GP21 itself (configured input + pull-up), once per ring refill. BLOCKING for the whole track (the shell cannot send while the mix runs). Returns the same packed rate/refills/underruns word as `play_file`.",
            args: {},
            leases: {
                "name": (type: "[u8]", read: true, max_len: Some(12)),
            },
            reply: Result(ok: "u32", err: CLike("PwmError")),
        ),
    },
)
