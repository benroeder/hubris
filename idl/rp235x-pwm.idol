// RP2350 (RP235x) PWM driver API.
//
// Minimal duty-cycle control: 1 kHz period, percent duty on one channel of
// one of the twelve slices. The GPIO must separately be function-selected to
// PWM (funcsel 4) via the GPIO driver.

Interface(
    name: "Rp235xPwm",
    ops: {
        "set_duty": (
            description: "Drive slice/channel (chan_b: 0 = A, nonzero = B) at `percent` duty, 1 kHz. Enables the slice.",
            args: { "slice": "u8", "chan_b": "u8", "percent": "u8" },
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
        "disable": (
            description: "Stop a slice (both channels).",
            args: { "slice": "u8" },
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
        "tone": (
            description: "Play a square wave on channel A of `slice` at `freq_hz` (100..=6000) for `ms`, then stop (silence).",
            args: { "slice": "u8", "freq_hz": "u32", "ms": "u32" },
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
        "sine": (
            description: "Play a sine wave on channel A of `slice` at `freq_hz` (50..=5000) for `ms` via PWM-as-1-bit-DAC (DDS over a sine LUT), then stop (silence).",
            args: { "slice": "u8", "freq_hz": "u32", "ms": "u32" },
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
        "audio_start": (
            description: "Start a seamless-looping sine near `freq_hz` (50..=8000) in BOTH ears of the audio jack (GP18 = slice 1 chan A = left, GP19 = chan B = right), fed by a DMA ring of stereo (u32) samples paced by the slice-1 wrap. Non-blocking: returns immediately and the DMA loops with zero CPU. Pitch snaps to whole cycles across the sample buffer.",
            args: { "freq_hz": "u32" },
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
        "audio_stereo": (
            description: "Start a seamless-looping stereo sine on the audio jack: `hz_left` (50..=8000) on GP18 (slice 1 chan A) and `hz_right` (50..=8000) on GP19 (chan B), fed by one DMA ring of u32 samples paced by the slice-1 wrap. Non-blocking. Each channel snaps to whole cycles across the sample buffer.",
            args: { "hz_left": "u32", "hz_right": "u32" },
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
        "audio_stop": (
            description: "Stop the DMA-fed audio-jack sine: abort the DMA channel and disable slice 1.",
            args: {},
            reply: Result(ok: "()", err: CLike("PwmError")),
            idempotent: true,
        ),
    },
)
